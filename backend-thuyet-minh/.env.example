# Sao chép file này thành .env rồi sửa theo máy của bạn.

# --- Database ---
# Nếu mật khẩu có ký tự đặc biệt như @ : / thì phải URL-encode (ví dụ @ thành %40).
DB_USER=root
DB_PASSWORD=123456
DB_HOST=localhost
DB_PORT=3306
DB_NAME=museum_audio_guide

# --- JWT đăng nhập CMS ---
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Domain frontend được phép gọi API, cách nhau bởi dấu phẩy ---
# Khi public qua Tailscale có thể thêm https://<tên-máy>.<tailnet>.ts.net
# (không bắt buộc vì request đi qua proxy của Vite, cùng origin).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Service TTS ---
# Địa chỉ nội bộ giữa các service
TTS_SERVICE_URL=http://localhost:8001
# Địa chỉ trình duyệt dùng để phát audio TTS. Giữ /tts (đi qua proxy Vite) để máy khác cũng nghe được.
TTS_PUBLIC_URL=/tts

# development: in toàn bộ câu SQL ra console
ENV=development
